{
  "name": "mancardo-release-checks",
  "private": true,
  "scripts": {
    "build:production": "node scripts/build-production.cjs",
    "test:source": "node scripts/check-production.cjs source",
    "test:packaged-server": "node scripts/check-production.cjs packaged-server",
    "test:browser": "node scripts/check-production.cjs browser",
    "test:waypoints": "node --test tests/waypoint-display.test.cjs",
